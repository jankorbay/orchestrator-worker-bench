# Hypothesis under test: Opus as the "brain" (plans, briefs, reviews) + a fast model doing the work.
# All arms use the same boss and the same prompt; only the worker differs.

# Boss / orchestrator (all arms)
ORCH_MODEL=opus
ORCH_EFFORT=high
# Worker that does every task, per arm
A_WORKER_MODEL=opus
A_WORKER_EFFORT=medium
B_WORKER_MODEL=haiku
B_WORKER_EFFORT=xhigh
C_WORKER_MODEL=haiku
C_WORKER_EFFORT=high
D_WORKER_MODEL=haiku
D_WORKER_EFFORT=medium
E_WORKER_MODEL=sonnet
E_WORKER_EFFORT=high
# Hard cap per run, in API-equivalent dollars
MAX_BUDGET_USD=15
# Tools the agents may use without asking, comma-separated (-p mode denies everything else).
# Compound shell (loops, $(mktemp)) is still denied; denials are listed in the report.
# In a sandbox/VM you can allow every shell command by replacing the Bash(...) entries with: Bash
ALLOWED_TOOLS="Read,Edit,Write,Glob,Grep,Agent,Bash(python3 *),Bash(python *),Bash(cd *),Bash(ls *),Bash(cat *),Bash(echo *),Bash(head *),Bash(tail *),Bash(grep *),Bash(find *),Bash(wc *),Bash(diff *),Bash(mkdir *),Bash(cp *),Bash(sort *)"
